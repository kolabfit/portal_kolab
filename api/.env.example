# Portal Ko+Lab - Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=portal_kolab

# Application
NODE_ENV=production
JWT_SECRET=your_jwt_secret_key_here
PORT=3001
APP_URL=https://api-portal.kolab.top
PUBLIC_API_URL=https://api-portal.kolab.top/api
CORS_ORIGIN=https://portal.kolab.top,https://api-portal.kolab.top

# External integrations
GAS_URL=
GEMINI_API_KEY=

# Kroombox CDN (backend-only, NEVER expose to frontend)
KROOMBOX_CDN_BASE_URL=https://api-cdn.kroombox.com
KROOMBOX_CDN_API_KEY=
KROOMBOX_CDN_JWT=
KROOMBOX_CDN_PROJECT_ID=
KROOMBOX_CDN_SYNC_ENABLED=true

# Folder template surat (opsional). Default: api/template_surat di dalam proyek.
# LETTER_TEMPLATE_DIR=/path/ke/template_surat

# Integrasi nilai magang (menu Nilai Magang)
# URL aplikasi tanpa /api; kunci = INTEGRATION_API_KEY di .env aplikasi tujuan
SOCIAL_CREDIT_API_URL=
SOCIAL_CREDIT_API_KEY=
PRESENCE_API_URL=https://absen.kolab.top
PRESENCE_API_KEY=
