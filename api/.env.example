# Portal Ko+Lab - Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=portal_kolab

# Application
JWT_SECRET=your_jwt_secret_key_here
PORT=3001
APP_URL=https://api-portal.kolab.top
PUBLIC_API_URL=https://api-portal.kolab.top/api

# External integrations
GAS_URL=
GEMINI_API_KEY=

# Kroombox CDN (backend-only, NEVER expose to frontend)
KROOMBOX_CDN_BASE_URL=https://api-cdn.kroombox.com
KROOMBOX_CDN_API_KEY=
KROOMBOX_CDN_JWT=
KROOMBOX_CDN_PROJECT_ID=
KROOMBOX_CDN_SYNC_ENABLED=true
